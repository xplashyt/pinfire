# Llave pública de Wompi (segura para el navegador)
# Sandbox: empieza con pub_test_...  Producción: pub_prod_...
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxx

# Secreto de integridad (NUNCA exponer en el cliente)
# Se usa en /api/wompi/signature para firmar cada transacción
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxx

# Secreto de eventos (NUNCA exponer en el cliente)
# Se usa en /api/wompi/webhook para verificar que el evento viene de Wompi
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxx

# Opcional: llave privada, solo si vas a consultar el estado de una
# transacción directamente contra la API de Wompi desde tu backend
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxx
